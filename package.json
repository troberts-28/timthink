{
  "name": "timthink",
  "version": "0.1.0",
  "private": true,
  "description": "A local hub for reading, reviewing and tracking the markdown plans your coding agents write.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/troberts-28/timthink.git"
  },
  "homepage": "https://github.com/troberts-28/timthink#readme",
  "bugs": {
    "url": "https://github.com/troberts-28/timthink/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @timthink/server --filter @timthink/web dev",
    "build": "pnpm --filter @timthink/server build && pnpm --filter @timthink/cli build && pnpm --filter @timthink/web build",
    "start": "node cli/dist/main.js serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^22.20.5",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
